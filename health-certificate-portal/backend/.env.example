# Backend
PORT=4000

# MongoDB Atlas
MONGO_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/?Baladia=Cluster0

# Frontend URL for CORS (single deployment)
FRONTEND_URL=https://your-app.vercel.app

# Main deployment (single)
MAIN_DEPLOYMENT_URL=https://your-app.vercel.app

# Generate a new random secret and replace this placeholder
JWT_SECRET=your-secret-key-here

# Admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-admin-password-here

# Cloudinary (REQUIRED for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret